{
  "version": "1.0.0",
  "title": "Macro Oscillator Folded Bass",
  "description": "A step sequencer plays a macro oscillator's waveshaping model as a bassline: a skewed triangle through a wavefolder, plucked by the built-in low-pass gate, so each note starts bright and folded and settles to a round tone.",
  "modules": [
    { "id": "clock", "type": "clock", "config": { "bpm": 96.0 } },
    {
      "id": "seq",
      "type": "step_sequencer",
      "config": {
        "root_note": 36,
        "step_count": 8,
        "gate_length": 0.5,
        "pattern": [
          { "note": 0 },
          { "note": 0 },
          { "note": 12 },
          { "note": 0 },
          { "note": 3 },
          { "note": 5 },
          { "note": 7 },
          { "note": 10 }
        ]
      }
    },
    {
      "id": "voice",
      "type": "macro_oscillator",
      "config": {
        "model": "waveshaping",
        "harmonics": 0.7,
        "timbre": 0.55,
        "morph": 0.3,
        "decay": 0.6,
        "level": 0.8
      }
    },
    { "id": "dac", "type": "dac" }
  ],
  "connections": [
    { "from": "clock", "from_port": "beat_x2", "to": "seq", "to_port": "clock" },
    { "from": "seq", "from_port": "frequency", "to": "voice", "to_port": "frequency" },
    { "from": "seq", "from_port": "gate", "to": "voice", "to_port": "trigger" },
    { "from": "voice", "from_port": "audio", "to": "dac", "to_port": "audio" }
  ]
}
