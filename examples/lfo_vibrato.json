{
  "version": "1.0.0",
  "title": "LFO Vibrato Melody",
  "description": "Demonstrates LFO modulation for vibrato effect - sine LFO modulates oscillator pitch",
  "modules": [
    {
      "id": "clock",
      "type": "clock",
      "config": {
        "bpm": 80.0
      }
    },
    {
      "id": "melody",
      "type": "melody",
      "config": {
        "root_note": 60,
        "degrees": [0, 4, 7, 11, 12],
        "note_weights": [1.5, 1.0, 1.0, 0.5, 1.0]
      }
    },
    {
      "id": "vibrato_lfo",
      "type": "lfo",
      "config": {
        "rate": 5.5,
        "waveform": "sine"
      }
    },
    {
      "id": "osc",
      "type": "oscillator",
      "config": {
        "waveform": "sawtooth",
        "frequency_mod_depth": 8.0
      }
    },
    {
      "id": "adsr",
      "type": "adsr",
      "config": {
        "attack": 0.1,
        "decay": 0.15,
        "sustain": 0.6,
        "release": 0.5
      }
    },
    {
      "id": "vca",
      "type": "vca"
    },
    {
      "id": "dac",
      "type": "dac"
    }
  ],
  "connections": [
    {
      "from": "clock",
      "from_port": "beat",
      "to": "melody",
      "to_port": "gate"
    },
    {
      "from": "melody",
      "from_port": "frequency",
      "to": "osc",
      "to_port": "frequency"
    },
    {
      "from": "vibrato_lfo",
      "from_port": "bipolar",
      "to": "osc",
      "to_port": "frequency_mod"
    },
    {
      "from": "melody",
      "from_port": "gate",
      "to": "adsr",
      "to_port": "gate"
    },
    {
      "from": "osc",
      "from_port": "audio",
      "to": "vca",
      "to_port": "audio"
    },
    {
      "from": "adsr",
      "from_port": "envelope",
      "to": "vca",
      "to_port": "level"
    },
    {
      "from": "vca",
      "from_port": "audio",
      "to": "dac",
      "to_port": "audio"
    }
  ]
}
