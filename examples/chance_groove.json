{
  "version": "1.0.0",
  "title": "Chance Groove",
  "description": "One chance module plays a whole groove: divider gates drive a synthesized kick and snare, its step tick drives the hats and a filtered lead, and the lead's pitches wander in D dorian. repetition 0.8 keeps a 16-step phrase that mutates a little each pass.",
  "modules": [
    {"id": "clock", "type": "clock", "config": {"bpm": 104.0}},
    {"id": "chance", "type": "chance", "config": {"seed": 7, "rate": "x4", "mode": "divider", "bias": 0.4, "repetition": 0.8, "loop_length": 16, "key": "D", "scale": "dorian", "low_note": 50, "range": 19, "steps": 0.7, "spread": 0.8, "value_bias": 0.45}},
    {"id": "lead_osc", "type": "oscillator", "config": {"waveform": "sawtooth"}},
    {"id": "lead_filter", "type": "filter", "config": {"filter_type": "lowpass", "cutoff": 900.0, "resonance": 0.35}},
    {"id": "lead_env", "type": "adsr", "config": {"attack": 0.004, "decay": 0.16, "sustain": 0.0, "release": 0.1}},
    {"id": "lead_vca", "type": "vca"},
    {"id": "kick_osc", "type": "oscillator", "config": {"waveform": "sine", "frequency": 46.0, "frequency_mod_depth": 120.0}},
    {"id": "kick_pitch", "type": "adsr", "config": {"attack": 0.001, "decay": 0.05, "sustain": 0.0, "release": 0.03}},
    {"id": "kick_env", "type": "adsr", "config": {"attack": 0.001, "decay": 0.28, "sustain": 0.0, "release": 0.08}},
    {"id": "kick_vca", "type": "vca"},
    {"id": "snare_body", "type": "oscillator", "config": {"waveform": "triangle", "frequency": 180.0, "frequency_mod_depth": 70.0}},
    {"id": "snare_rattle", "type": "oscillator", "config": {"waveform": "square", "frequency": 3170.0}},
    {"id": "snare_band", "type": "filter", "config": {"filter_type": "bandpass", "cutoff": 3600.0, "resonance": 0.2}},
    {"id": "snare_env", "type": "adsr", "config": {"attack": 0.001, "decay": 0.13, "sustain": 0.0, "release": 0.06}},
    {"id": "snare_body_vca", "type": "vca"},
    {"id": "snare_rattle_vca", "type": "vca"},
    {"id": "hat_osc", "type": "oscillator", "config": {"waveform": "square", "frequency": 7919.0}},
    {"id": "hat_filter", "type": "filter", "config": {"filter_type": "highpass", "cutoff": 7000.0, "resonance": 0.1}},
    {"id": "hat_env", "type": "adsr", "config": {"attack": 0.001, "decay": 0.03, "sustain": 0.0, "release": 0.02}},
    {"id": "hat_vca", "type": "vca"},
    {"id": "mixer", "type": "mixer", "config": {"channel_count": 5, "levels": [0.22, 0.75, 0.35, 0.12, 0.06], "pans": [0.2, 0.0, -0.05, 0.1, -0.35], "master": 0.8}},
    {"id": "reverb", "type": "reverb", "config": {"room_size": 0.5, "damping": 0.5, "wet": 0.18, "dry": 0.85}},
    {"id": "dac", "type": "dac"}
  ],
  "connections": [
    {"from": "chance", "from_port": "tick", "to": "lead_env", "to_port": "gate"},
    {"from": "chance", "from_port": "frequency_3", "to": "lead_osc", "to_port": "frequency"},
    {"from": "lead_osc", "from_port": "audio", "to": "lead_filter", "to_port": "audio"},
    {"from": "lead_env", "from_port": "envelope", "to": "lead_filter", "to_port": "cutoff_mod"},
    {"from": "lead_filter", "from_port": "audio", "to": "lead_vca", "to_port": "audio"},
    {"from": "lead_env", "from_port": "envelope", "to": "lead_vca", "to_port": "level"},
    {"from": "chance", "from_port": "gate_1", "to": "kick_pitch", "to_port": "gate"},
    {"from": "chance", "from_port": "gate_1", "to": "kick_env", "to_port": "gate"},
    {"from": "kick_pitch", "from_port": "envelope", "to": "kick_osc", "to_port": "frequency_mod"},
    {"from": "kick_osc", "from_port": "audio", "to": "kick_vca", "to_port": "audio"},
    {"from": "kick_env", "from_port": "envelope", "to": "kick_vca", "to_port": "level"},
    {"from": "chance", "from_port": "gate_2", "to": "snare_env", "to_port": "gate"},
    {"from": "snare_env", "from_port": "envelope", "to": "snare_body", "to_port": "frequency_mod"},
    {"from": "snare_body", "from_port": "audio", "to": "snare_body_vca", "to_port": "audio"},
    {"from": "snare_env", "from_port": "envelope", "to": "snare_body_vca", "to_port": "level"},
    {"from": "snare_rattle", "from_port": "audio", "to": "snare_band", "to_port": "audio"},
    {"from": "snare_band", "from_port": "audio", "to": "snare_rattle_vca", "to_port": "audio"},
    {"from": "snare_env", "from_port": "envelope", "to": "snare_rattle_vca", "to_port": "level"},
    {"from": "chance", "from_port": "tick", "to": "hat_env", "to_port": "gate"},
    {"from": "hat_osc", "from_port": "audio", "to": "hat_filter", "to_port": "audio"},
    {"from": "hat_filter", "from_port": "audio", "to": "hat_vca", "to_port": "audio"},
    {"from": "hat_env", "from_port": "envelope", "to": "hat_vca", "to_port": "level"},
    {"from": "lead_vca", "from_port": "audio", "to": "mixer", "to_port": "audio.0"},
    {"from": "kick_vca", "from_port": "audio", "to": "mixer", "to_port": "audio.1"},
    {"from": "snare_body_vca", "from_port": "audio", "to": "mixer", "to_port": "audio.2"},
    {"from": "snare_rattle_vca", "from_port": "audio", "to": "mixer", "to_port": "audio.3"},
    {"from": "hat_vca", "from_port": "audio", "to": "mixer", "to_port": "audio.4"},
    {"from": "clock", "from_port": "beat", "to": "chance", "to_port": "clock"},
    {"from": "mixer", "from_port": "audio_left", "to": "reverb", "to_port": "audio_left"},
    {"from": "mixer", "from_port": "audio_right", "to": "reverb", "to_port": "audio_right"},
    {"from": "reverb", "from_port": "audio_left", "to": "dac", "to_port": "audio_left"},
    {"from": "reverb", "from_port": "audio_right", "to": "dac", "to_port": "audio_right"}
  ]
}
