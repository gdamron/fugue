{
  "version": "1.0.0",
  "title": "Macro Oscillator Wavetable Arpeggio",
  "description": "A minor arpeggio on a macro oscillator's wavetable model, from its formant bank: vowel-like resonances partway along the bank, with the gate's level mode holding each note for as long as the step's gate is high.",
  "modules": [
    { "id": "clock", "type": "clock", "config": { "bpm": 96.0 } },
    {
      "id": "seq",
      "type": "step_sequencer",
      "config": {
        "root_note": 45,
        "step_count": 8,
        "gate_length": 0.7,
        "pattern": [
          { "note": 0 },
          { "note": 7 },
          { "note": 12 },
          { "note": 15 },
          { "note": 19 },
          { "note": 15 },
          { "note": 12 },
          { "note": 3 }
        ]
      }
    },
    {
      "id": "voice",
      "type": "macro_oscillator",
      "config": {
        "model": "wavetable",
        "harmonics": 0.143,
        "timbre": 0.55,
        "morph": 0.3,
        "level": 0.7
      }
    },
    { "id": "dac", "type": "dac" }
  ],
  "connections": [
    { "from": "clock", "from_port": "beat_x2", "to": "seq", "to_port": "clock" },
    { "from": "seq", "from_port": "frequency", "to": "voice", "to_port": "frequency" },
    { "from": "seq", "from_port": "gate", "to": "voice", "to_port": "level" },
    { "from": "voice", "from_port": "audio", "to": "dac", "to_port": "audio" }
  ]
}
