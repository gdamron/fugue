{
  "version": "1.0.0",
  "title": "Macro Oscillator Additive Organ",
  "description": "A macro oscillator's additive model played from its organ output: eight drawbar harmonics with a broad, low spectral peak. The gate's level mode holds each note at full level for as long as the step's gate is high, like a key held down.",
  "modules": [
    { "id": "clock", "type": "clock", "config": { "bpm": 84.0 } },
    {
      "id": "seq",
      "type": "step_sequencer",
      "config": {
        "root_note": 48,
        "step_count": 8,
        "gate_length": 0.9,
        "pattern": [
          { "note": 0 },
          { "note": 7 },
          { "note": 12 },
          { "note": 16 },
          { "note": 14 },
          { "note": 12 },
          { "note": 7 },
          { "note": 4 }
        ]
      }
    },
    {
      "id": "voice",
      "type": "macro_oscillator",
      "config": {
        "model": "additive",
        "harmonics": 0.1,
        "timbre": 0.3,
        "morph": 0.35,
        "level": 0.8
      }
    },
    { "id": "dac", "type": "dac" }
  ],
  "connections": [
    { "from": "clock", "from_port": "beat_x2", "to": "seq", "to_port": "clock" },
    { "from": "seq", "from_port": "frequency", "to": "voice", "to_port": "frequency" },
    { "from": "seq", "from_port": "gate", "to": "voice", "to_port": "level" },
    { "from": "voice", "from_port": "aux", "to": "dac", "to_port": "audio" }
  ]
}
